<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command-line reader that runs on Linux (and Windows). It lists the battery
    of every device once and exits: same Core/Interop/Providers as the app, no
    window, no tray, no loop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>joule-cli</AssemblyName>
    <RootNamespace>BatteryTray.Cli</RootNamespace>
    <Product>Joule CLI</Product>
    <Version>0.1.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- Autostart writes the Windows registry; the CLI never starts on login. -->
    <Compile Include="..\BatteryTray\Core\**\*.cs" Exclude="..\BatteryTray\Core\Autostart.cs" />
    <Compile Include="..\BatteryTray\Interop\**\*.cs" />
    <Compile Include="..\BatteryTray\Providers\**\*.cs" />
    <Compile Include="..\BatteryTray\Ui\AppInfo.cs" />
  </ItemGroup>

</Project>
