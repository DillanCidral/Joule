<!-- Estilos das janelas de telas em sequencia (boas-vindas, Mandar meu aparelho). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:BatteryTray.Ui">

    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource Text.Primary}" />
    </Style>
    <!-- Icones cheios (Icons.cs, Silhueta): o Glyph acima segue de traco para os desenhos proprios das telas. -->
    <Style x:Key="IconGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Fill" Value="{Binding Stroke, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Foreground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="4" Height="32" MinWidth="104" Padding="16,0" Background="{DynamicResource Accent}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" ui:Motion.Hover="{DynamicResource Card.FillHover}" ui:Motion.Press="0.97" CornerRadius="4" Height="32" Padding="12,0" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botao secundario com contorno: "Procurar de novo", "Por e-mail", Gmail... -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" ui:Motion.Hover="{DynamicResource Card.FillHover}" ui:Motion.Press="0.97" CornerRadius="4" Padding="14,0" BorderThickness="1"
                            BorderBrush="{DynamicResource Level.Track}" Background="{DynamicResource Button.Fill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Acao em texto amarelo (Accent.Text): "Adicionar outro aparelho", "Copiar endereco". -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" ui:Motion.Hover="{DynamicResource Card.FillHover}" ui:Motion.Press="0.97" CornerRadius="4" Height="32" Padding="8,0" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Level.Track}" Background="{DynamicResource Card.Fill}">
                        <Grid Margin="12,0">
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
    </Style>

    <Style x:Key="GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Icone num quadradinho, como os aparelhos no painel. -->
    <Style x:Key="TileBox" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource Tile.Fill}" />
    </Style>

    <Style x:Key="Point" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="PointTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Card.Fill}" />
    </Style>
</ResourceDictionary>
