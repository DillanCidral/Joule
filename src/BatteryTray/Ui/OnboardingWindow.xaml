<ui:WizardWindow x:Class="BatteryTray.Ui.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BatteryTray.Ui"
        Width="520" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="False"
        WindowStartupLocation="Manual" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        Foreground="{DynamicResource Text.Primary}">

    <ui:WizardWindow.Resources>
        <ResourceDictionary Source="WizardStyles.xaml" />
    </ui:WizardWindow.Resources>

    <Border x:Name="Root" Padding="32,24,24,20" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Lift" />
        </Border.RenderTransform>
        <DockPanel>
            <!-- Marca, selo de beta e "Pular". -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                <Button x:Name="SkipButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="{ui:Tr 'Pular', 'Skip'}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- A marca como no painel: Geist 600 e o ponto amarelo depois do nome. -->
                    <TextBlock FontFamily="pack://application:,,,/Fonts/#Geist" FontSize="15" FontWeight="SemiBold" LineHeight="20" VerticalAlignment="Center">
                        <Run x:Name="BrandText" /><InlineUIContainer BaselineAlignment="Baseline">
                            <Ellipse Width="2.6" Height="2.6" Margin="0.6,0,0,0.4" Fill="{DynamicResource Brand.Dot}" />
                        </InlineUIContainer>
                    </TextBlock>
                    <!-- Selo cheio e discreto: fundo amarelo a 16%, texto amarelo (escuro no tema claro). -->
                    <Grid Margin="10,1,0,0" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="{DynamicResource Accent}" Opacity="0.16" />
                        <TextBlock Text="BETA" Margin="7,2,7,2" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent.Text}" />
                    </Grid>
                </StackPanel>
            </DockPanel>

            <!-- Pontinhos das telas e botoes. -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource FlatButton}" Content="{ui:Tr 'Voltar', 'Back'}" Margin="0,0,8,0" />
                    <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="{ui:Tr 'Próximo', 'Next'}" IsDefault="True" />
                </StackPanel>
                <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>

            <Grid x:Name="Pages">

                <!-- 1. Boas-vindas -->
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource Tile.Fill}" HorizontalAlignment="Left" Margin="0,4,0,20">
                        <Viewbox Width="32" Height="32">
                            <Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Bolt}" Stroke="{DynamicResource Accent}" />
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="WelcomeTitle" Style="{StaticResource Title}" />
                    <TextBlock Style="{StaticResource Lead}" Text="{ui:Tr 'A bateria do seu mouse, fone, controle e teclado sem fio, num lugar só.', 'Battery for your wireless mouse, headset, controller and keyboard, all in one place.'}" />
                    <Border Height="6" CornerRadius="3" Background="{DynamicResource Level.Track}" Margin="0,20,0,0" HorizontalAlignment="Left" Width="220">
                        <Border x:Name="FillBar" CornerRadius="3" Background="{DynamicResource Level.Fill}" HorizontalAlignment="Left" Width="0" />
                    </Border>
                    <Border Margin="0,24,0,0" Padding="14,12" CornerRadius="6" Background="{DynamicResource Card.Fill}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Esta é uma versão beta', 'This is a beta version'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Ainda estamos testando com muitos modelos. Pode ter aparelho que não aparece, ou que aparece como “sem dado”. Isso é esperado agora, e cada teste ajuda a chegar lá.', 'We’re still testing with many models. Some devices may not show up, or may show “no data”. That’s expected for now, and every test helps get there.'}" />
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- 2. Achei estes aparelhos (2026-11-07): o que o Joule ja le, ou o que fazer sem nada -->
                <StackPanel Visibility="Hidden">
                    <TextBlock x:Name="FoundTitle" Style="{StaticResource Title}" Text="{ui:Tr 'Achei estes aparelhos', 'I found these devices'}" />
                    <TextBlock x:Name="FoundLead" Style="{StaticResource Lead}" Text="{ui:Tr 'É o que o Joule já sabe ler neste computador.', 'This is what Joule can already read on this computer.'}" Margin="0,0,0,14" />
                    <StackPanel x:Name="FoundList" />
                    <TextBlock x:Name="OthersNote" Style="{StaticResource Caption}" Margin="50,4,0,0" />
                    <Border x:Name="MissingCard" Style="{StaticResource Card}" Margin="0,20,0,0">
                        <DockPanel>
                            <Button x:Name="MissingButton" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="{ui:Tr 'Meu aparelho não apareceu', 'My device didn’t show up'}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Faltou algum?', 'Missing one?'}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Mande os dados dele e a gente tenta ensinar o Joule a ler.', 'Send its details and we’ll try to teach Joule to read it.'}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="EmptyPoints">
                        <DockPanel Style="{StaticResource Point}">
                            <Border Style="{StaticResource TileBox}">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Glyph}" Data="M10 3v6M6 5.5a6 6 0 1 0 8 0" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Ligue e conecte', 'Turn on and connect'}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Receptor USB espetado, ou Bluetooth pareado e conectado. Depois clique em Procurar de novo.', 'USB receiver plugged in, or Bluetooth paired and connected. Then click Search again.'}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Point}">
                            <Border Style="{StaticResource TileBox}">
                                <Viewbox Width="18" Height="18"><Path Style="{StaticResource Glyph}" Data="M4 16h12M10 3.5v9M6.5 9l3.5 3.5L13.5 9" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Se continuar sem aparecer', 'If it still doesn’t show up'}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'O Joule ainda não conhece esse modelo. Mande os dados dele: leva uns dois minutos e ajuda a próxima versão a ler.', 'Joule doesn’t know that model yet. Send its details: it takes about two minutes and helps the next version read it.'}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="50,6,0,0">
                            <Button x:Name="SearchAgainButton" Style="{StaticResource OutlineButton}" Content="{ui:Tr 'Procurar de novo', 'Search again'}" Margin="0,0,8,0" />
                            <Button x:Name="SendButton" Style="{StaticResource OutlineButton}" Content="{ui:Tr 'Mandar meu aparelho', 'Send my device'}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Onde ele mora -->
                <StackPanel Visibility="Hidden">
                    <TextBlock Style="{StaticResource Title}" Text="{ui:Tr 'Onde ele fica', 'Where it lives'}" />
                    <TextBlock Style="{StaticResource Lead}" Text="{ui:Tr 'Olhe os cantos da tela: o Joule abriu tudo para você ver.', 'Look at the corners of the screen: Joule opened everything for you to see.'}" Margin="0,0,0,20" />
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Bolt}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Ícone ao lado do relógio', 'Icon next to the clock'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'O que está com o anel amarelo. Clique nele para abrir o painel. Se não estiver lá, procure na setinha ^ da barra de tarefas.', 'The one with the yellow ring. Click it to open the panel. If it’s not there, look under the ^ arrow on the taskbar.'}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Sliders}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Widget na borda da tela', 'Widget on the screen edge'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Normalmente é só uma faixa fina. Passe o mouse para ele abrir assim; arraste para mudar de lugar.', 'Usually it’s just a thin strip. Hover to open it like this; drag to move it.'}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource Glyph}" Data="M2.5 5.5h15v9h-15zM2.5 8.5h15" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'O painel', 'The panel'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Todos os seus aparelhos, com a bateria de cada um.', 'All your devices, each with its battery.'}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- 4. Como ele le -->
                <StackPanel Visibility="Hidden">
                    <TextBlock Style="{StaticResource Title}" Text="{ui:Tr 'Como ele lê a bateria', 'How it reads the battery'}" />
                    <TextBlock Style="{StaticResource Lead}" Text="{ui:Tr 'Com cuidado, para nunca atrapalhar seus aparelhos.', 'Carefully, so it never gets in your devices’ way.'}" Margin="0,0,0,20" />
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Refresh}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Só quando você pede', 'Only when you ask'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Ao abrir o Joule, ao ligar o computador e no botão Atualizar, o destacado no painel. Ele não fica perguntando sem parar.', 'When Joule opens, when the computer starts, and with the Refresh button, the one highlighted in the panel. It never keeps asking nonstop.'}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Mouse}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Alguns aparelhos recebem uma pergunta', 'Some devices get asked a question'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Em algumas marcas ligadas pelo receptor USB (Logitech, Razer, SteelSeries, HyperX, Corsair e outras), o Joule faz a mesma pergunta de bateria que o programa da marca faz. Só essa pergunta, uma vez por leitura. Ele nunca muda nada no aparelho.', 'For some brands connected through a USB receiver (Logitech, Razer, SteelSeries, HyperX, Corsair and others), Joule asks the same battery question the brand’s own software asks. Only that question, once per reading. It never changes anything on the device.'}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Headset}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="Bluetooth" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'O Windows já guarda a bateria dos aparelhos Bluetooth. O Joule só lê esse número.', 'Windows already stores the battery of Bluetooth devices. Joule only reads that number.'}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- 5. Se der algo estranho -->
                <StackPanel Visibility="Hidden">
                    <TextBlock Style="{StaticResource Title}" Text="{ui:Tr 'Se algo parecer estranho', 'If something looks off'}" />
                    <TextBlock Style="{StaticResource Lead}" Text="{ui:Tr 'Quase tudo se resolve assim:', 'Almost everything is fixed like this:'}" Margin="0,0,0,20" />
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Refresh}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Feche e abra de novo', 'Close and reopen it'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Botão direito no ícone, Sair, e abra o Joule outra vez. Não estraga nada e não mexe nos seus aparelhos.', 'Right-click the icon, choose Exit, and open Joule again. It breaks nothing and doesn’t touch your devices.'}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Clock}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Número com um reloginho', 'A number with a little clock'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'É a última leitura guardada, não a de agora. Clique em Atualizar para ler de novo.', 'It’s the last saved reading, not a current one. Click Refresh to read again.'}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Point}">
                        <Border Style="{StaticResource TileBox}">
                            <Viewbox Width="18" Height="18"><Path Style="{StaticResource IconGlyph}" Data="{x:Static ui:Icons.Generic}" Stroke="{DynamicResource Text.Secondary}" /></Viewbox>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PointTitle}" Text="{ui:Tr 'Aparelho que não aparece', 'A device that doesn’t show up'}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{ui:Tr 'Veja em “Mostrar outros”, no fim do painel: lá ficam os que o Joule achou mas ainda não sabe ler. Se nem lá ele aparecer, use “Mandar meu aparelho”, nas Configurações.', 'Check “Show others” at the bottom of the panel: that’s where devices Joule found but can’t read yet go. If it’s not there either, use “Send my device” in Settings.'}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</ui:WizardWindow>
