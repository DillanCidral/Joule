<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Harness de validacao. NAO faz parte do app entregue: apenas reaproveita as
    mesmas classes de Core/Interop/Providers para rodar uma leitura no console
    e imprimir o resultado. Somente leitura, igual ao app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BatteryDiag</AssemblyName>
    <RootNamespace>BatteryTray.Diag</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Diag.cs" />
    <Compile Include="SelfTest.cs" />
    <Compile Include="FeatureProbe.cs" />
    <Compile Include="..\..\src\BatteryTray\Core\**\*.cs" />
    <Compile Include="..\..\src\BatteryTray\Interop\**\*.cs" />
    <Compile Include="..\..\src\BatteryTray\Providers\**\*.cs" />
    <!-- Nome, Id e canal: AppPaths e Autostart dependem dele desde o nome Joule. -->
    <Compile Include="..\..\src\BatteryTray\Ui\AppInfo.cs" />
  </ItemGroup>

</Project>
